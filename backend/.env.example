PORT=5000
MONGO_URI=mongodb://localhost:27017/saferoute
JWT_SECRET=change_this_to_a_long_random_string
# Free key from https://openrouteservice.org/dev/#/signup - no credit card needed
ORS_API_KEY=your_openrouteservice_api_key_here
CLIENT_URL=http://localhost:5173

# Bounding box for the ONE city/town this deployment precomputes safety
# scores for (used only by `npm run build:grid`, not by the running server).
# Get these 4 numbers from https://bboxfinder.com — draw a box around your
# city, it gives you "minLng,minLat,maxLng,maxLat", map that to west,south,east,north.
CITY_BBOX_SOUTH=
CITY_BBOX_WEST=
CITY_BBOX_NORTH=
CITY_BBOX_EAST=

# Public Overpass instance by default. Fine for a one-time/occasional batch
# job; if you self-host Overpass later, point this there instead.
OVERPASS_URL=https://overpass-api.de/api/interpreter
